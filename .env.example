# Copy to .env and fill in what you need. Nothing here is required to run
# the test suites (pnpm test, pnpm run test:phase4).

# --- Sepolia ---------------------------------------------------------------
# Needed for scripts run with --network sepolia (pipeline submit,
# propose/approve, gas and latency benchmarks, verifyComponent benchmark).
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<your-key>
SEPOLIA_PRIVATE_KEY=

# Registry used in the paper. Replace it if you deploy your own.
CONTRACT_ADDRESS=0x32010dD1A7393BA546ba2220FCb6126F160E6CB0

# Threshold-approval path (scripts/pipeline-propose-approve.ts) and the two
# approvers of scripts/benchmark-gas-stats.ts on Sepolia.
# Both accounts need TEAM_MEMBER_ROLE (see scripts/grant-team-roles.ts).
REVIEWER_1_KEY=
REVIEWER_2_KEY=
REVIEWER_1_ADDRESS=
REVIEWER_2_ADDRESS=

# --- Local chain -------------------------------------------------------------
# "guardian" network in hardhat.config.ts (a Geth dev chain, chainId 1337)
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=
# "devnet" network, same idea, read via process.env
DEVNET_RPC_URL=http://127.0.0.1:8545
DEVNET_PRIVATE_KEY=

# --- API (apps/api) ----------------------------------------------------------
# The API reads this file from the repo root too. It uses SEPOLIA_RPC_URL
# when set, otherwise RPC_URL.
BE_PORT=5006
CHAIN_NAME=Sepolia
PROJECT_ID=sbom-blockchain-guardian
# SBOM_STORAGE_DIR=apps/api/storage/sboms
# API_JSON_LIMIT=5mb

# --- Web (apps/web) ----------------------------------------------------------
NEST_API_URL=http://localhost:5006
